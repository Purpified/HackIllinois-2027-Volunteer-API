# Copy to .env if you want to change anything. Every variable has a default.

# Port the API listens on.
PORT=3000

# Leave MONGO_URI unset to boot an in-memory MongoDB automatically (nothing to install,
# data is discarded on exit). Set it to use a real server, for example the local one:
# MONGO_URI=mongodb://127.0.0.1:27017/volunteer_api

# Reference instant for demo data: seeded shift times are derived from it, so they never go stale.
EVENT_START=2027-02-26T17:00:00-06:00
