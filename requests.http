### Request collection for the VS Code REST Client / JetBrains HTTP Client.
### Start the API with `npm run dev`, then send any block. Paste ids into the variables as you go.
### On an empty database, dev startup seeds demo data and prints ids to paste into the variables.

@base = http://localhost:3000
@volunteerId = 000000000000000000000000

### Health
GET {{base}}/health

### Create a volunteer
POST {{base}}/volunteers
Content-Type: application/json

{
  "name": "Ada Lovelace",
  "email": "ada@illinois.edu",
  "phone": "217-555-0101"
}

### Create a volunteer: duplicate email (expect 409 DUPLICATE_EMAIL)
POST {{base}}/volunteers
Content-Type: application/json

{
  "name": "Ada Again",
  "email": "ADA@illinois.edu"
}

### Create a volunteer: validation failure (expect 400 VALIDATION_ERROR)
POST {{base}}/volunteers
Content-Type: application/json

{
  "email": "not-an-email",
  "isActive": false
}

### List volunteers
GET {{base}}/volunteers?page=1&limit=20

### Find a volunteer by email (how a client learns its own id without auth)
GET {{base}}/volunteers?email=ada@illinois.edu

### Get one volunteer
GET {{base}}/volunteers/{{volunteerId}}

### Get one volunteer: malformed id (expect 400)
GET {{base}}/volunteers/not-an-id

### Unknown route (expect 404 ROUTE_NOT_FOUND)
GET {{base}}/nope

### ---- Events -------------------------------------------------------------------------------
@eventId = 000000000000000000000000

### Create an event (times must carry a timezone offset or Z)
POST {{base}}/events
Content-Type: application/json

{
  "name": "Check-in and Opening Ceremony",
  "description": "Badge pickup, swag, welcome talk",
  "location": "Siebel Center atrium",
  "startTime": "2027-02-26T17:00:00-06:00",
  "endTime": "2027-02-26T20:00:00-06:00"
}

### Create an event: end before start (expect 400 naming endTime)
POST {{base}}/events
Content-Type: application/json

{
  "name": "Backwards",
  "startTime": "2027-02-26T17:00:00-06:00",
  "endTime": "2027-02-26T16:00:00-06:00"
}

### List events, sorted by start time
GET {{base}}/events

### List events overlapping a window
GET {{base}}/events?from=2027-02-26T22:00:00Z&to=2027-02-27T06:00:00Z

### Get one event
GET {{base}}/events/{{eventId}}

### Rename an event
PATCH {{base}}/events/{{eventId}}
Content-Type: application/json

{
  "name": "Opening Ceremony"
}

### ---- Shifts -------------------------------------------------------------------------------
@shiftId = 000000000000000000000000

### Create a shift under an event (may start before the event: setup crews)
POST {{base}}/events/{{eventId}}/shifts
Content-Type: application/json

{
  "role": "Check-in desk",
  "startTime": "2027-02-26T16:30:00-06:00",
  "endTime": "2027-02-26T19:00:00-06:00",
  "capacity": 4
}

### Create a shift: unknown event (expect 404 EVENT_NOT_FOUND)
POST {{base}}/events/000000000000000000000000/shifts
Content-Type: application/json

{
  "role": "Ghost shift",
  "startTime": "2027-02-26T17:00:00-06:00",
  "endTime": "2027-02-26T19:00:00-06:00",
  "capacity": 2
}

### Create a shift: eventId belongs in the path, not the body (expect 400)
POST {{base}}/events/{{eventId}}/shifts
Content-Type: application/json

{
  "eventId": "000000000000000000000000",
  "role": "Confused",
  "startTime": "2027-02-26T17:00:00-06:00",
  "endTime": "2027-02-26T19:00:00-06:00",
  "capacity": 2
}

### List an event's shifts, sorted by start time
GET {{base}}/events/{{eventId}}/shifts

### Get one shift
GET {{base}}/shifts/{{shiftId}}

### Raise a shift's capacity
PATCH {{base}}/shifts/{{shiftId}}
Content-Type: application/json

{
  "capacity": 6
}

### ---- Signups ------------------------------------------------------------------------------
@signupId = 000000000000000000000000

### Sign a volunteer up for a shift
POST {{base}}/shifts/{{shiftId}}/signups
Content-Type: application/json

{
  "volunteerId": "{{volunteerId}}"
}

### Sign up again (expect 409 ALREADY_SIGNED_UP; on a full shift, 409 SHIFT_FULL wins)
POST {{base}}/shifts/{{shiftId}}/signups
Content-Type: application/json

{
  "volunteerId": "{{volunteerId}}"
}

### Roster for a shift (?status=active hides cancellations)
GET {{base}}/shifts/{{shiftId}}/signups

### A volunteer's schedule
GET {{base}}/volunteers/{{volunteerId}}/signups

### Get one signup
GET {{base}}/signups/{{signupId}}

### Cancel a signup (releases the seat; the row remains as history)
POST {{base}}/signups/{{signupId}}/cancel

### Cancel again (expect 409 INVALID_TRANSITION)
POST {{base}}/signups/{{signupId}}/cancel
